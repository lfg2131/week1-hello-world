# Supabase browser client (public by design; protected by RLS). Never a service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Existing Assignment 2 server names remain supported as fallbacks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server-only Gemini credentials. Never prefix with NEXT_PUBLIC_.
# Local: .env.local. Vercel: Sensitive (Secret) Preview variable.
GEMINI_API_KEY=your-gemini-api-key
# Optional model override; defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Server-only, used after verified authentication for private generation config/telemetry.
# Set as a sensitive Vercel variable on week7-feedback; never expose to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
